# Copy this file to .env when running the optional FastAPI backend locally.

# MongoDB connection string, for example:
# MONGO_URL=mongodb://localhost:27017
MONGO_URL=

# MongoDB database name
DB_NAME=aurora_transport

# Comma-separated frontend origins allowed to call the API.
# Use your production domain in deploy environments.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://auroratransport.se
