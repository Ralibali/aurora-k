{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.auroratransport.se"
        }
      ],
      "destination": "https://auroratransport.se/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/blogg",
      "statusCode": 301
    },
    {
      "source": "/blogg/transportledningssystem-for-sma-akeries",
      "destination": "/blogg/transportledningssystem-for-sma-akerier",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/driver/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/platform/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/portal",
      "destination": "/app.html"
    },
    {
      "source": "/onboarding",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/register",
      "destination": "/app.html"
    },
    {
      "source": "/join",
      "destination": "/app.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/app.html"
    },
    {
      "source": "/reset-password",
      "destination": "/app.html"
    },
    {
      "source": "/track/:token",
      "destination": "/app.html"
    },
    {
      "source": "/boka/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/en/book",
      "destination": "/app.html"
    },
    {
      "source": "/auth/confirm",
      "destination": "/app.html"
    },
    {
      "source": "/integrations/fortnox/callback",
      "destination": "/app.html"
    },
    {
      "source": "/ads/:page(budtjanst|akeri|transport|flotta)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/driver/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/platform/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/onboarding",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/join",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
